<?xml version="1.0" encoding="utf-8"?>
<!-- Only the "lock" edition contains the accessibility service. The standard edition has none. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Off by default. Enabled only after the user agrees to the in-app disclosure. -->
        <service
            android:name=".LockService"
            android:enabled="false"
            android:exported="true"
            android:label="@string/lock_service"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/lock_service" />
        </service>
    </application>
</manifest>
